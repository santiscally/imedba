# -----------------------------------------------------------------------------
# Copiar a `.env` y ajustar. NO commitear `.env`.
# -----------------------------------------------------------------------------

# --- Postgres (una sola instancia, aloja DB imedba + DB keycloak) ------------
POSTGRES_DB=imedba
POSTGRES_USER=imedba
POSTGRES_PASSWORD=imedba_dev_change_me
POSTGRES_PORT=5432

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_change_me
KEYCLOAK_PORT=8081
KEYCLOAK_HOSTNAME=localhost
# URLs usadas por el backend. En dev apuntan al contenedor por red interna.
# En prod:
#   KEYCLOAK_ISSUER_URI  = https://${SERVER_NAME}/auth/realms/imedba     (publico, match del iss del JWT)
#   KEYCLOAK_JWK_SET_URI = http://keycloak:8080/auth/realms/imedba/protocol/openid-connect/certs  (interno)
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/imedba
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/imedba/protocol/openid-connect/certs

# Secret del client confidential imedba-backend. Regenerarlo en la consola
# Keycloak despues de importar el realm y pegarlo aca.
IMEDBA_BACKEND_CLIENT_SECRET=replace-me-after-realm-import

# --- Backend -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (Vite) ---------------------------------------------------------
FRONTEND_PORT=5173
# Vars inyectadas al build del SPA. En dev el browser habla directo contra los
# puertos expuestos; en prod el override usa "/api" y "/auth" (mismo origen).
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=imedba
VITE_KEYCLOAK_CLIENT_ID=imedba-frontend

# --- Nginx (prod) ------------------------------------------------------------
# Dominio publico del sitio. Debe matchear el CN/SAN del certificado TLS.
SERVER_NAME=imedba.local

# --- SendGrid ----------------------------------------------------------------
# NO usado (free tier discontinuado). El adapter queda dormido salvo que se ponga API key.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@imedba.local
SENDGRID_FROM_NAME=IMEDBA

# --- AWS SES por SMTP (proveedor de mail ACTIVO) -----------------------------
# Con SES_SMTP_HOST vacío queda el NoopMailSender (loguea, no envía). Al completar
# host + credenciales SMTP se activa el SmtpMailSender (STARTTLS 587).
#   SES_SMTP_HOST     = email-smtp.<region>.amazonaws.com (ej. sa-east-1 = São Paulo)
#   SES_SMTP_USERNAME / SES_SMTP_PASSWORD = del CSV del usuario IAM ses-smtp-user (SECRETO — no commitear)
#   MAIL_FROM_ADDRESS = remitente; su dominio debe estar verificado en SES (DKIM/SPF/DMARC)
# OJO: en sandbox SES sólo manda a destinatarios verificados. OJO hosting: algunos (DonWeb)
# bloquean el 587 saliente → si da timeout en prod, usar el fallback por API de abajo.
SES_SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@imedba.local
MAIL_FROM_NAME=IMEDBA

# --- AWS SES por API (fallback, HTTPS 443) ------------------------------------
# Alternativa si el hosting bloquea el SMTP saliente. Se activa con AWS_SES_FROM_EMAIL
# (dormido si está vacío). Requiere credenciales IAM access-key/secret — NO las SMTP.
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=IMEDBA
AWS_SES_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Moodle (LMS) ------------------------------------------------------------
# Deshabilitado hasta tener URL + token de David. Con MOODLE_ENABLED=false el
# backend NO llama a Moodle (cliente inerte). Para activar: poner true + URL + token.
#   MOODLE_URL   = https://www.imedba.com.ar   (sin /webservice/rest/server.php)
#   MOODLE_TOKEN = token del Web Service REST (SECRETO — no commitear; rotar si se filtró)
MOODLE_ENABLED=false
MOODLE_URL=
MOODLE_TOKEN=
MOODLE_DEFAULT_STUDENT_ROLE_ID=5
# Suspensión automática por mora (scheduler). Dejar en false hasta validar la integración
# en prod: con true, los morosos >=22 días YA vinculados se suspenden solos al arrancar.
MOODLE_AUTO_SUSPEND_ENABLED=false

# --- WhatsApp ----------------------------------------------------------------
# Canal nuevo, sin proveedor real todavía (NoopWhatsAppSender loguea, no envía).
WHATSAPP_ENABLED=false

# --- Misc --------------------------------------------------------------------
TZ=America/Argentina/Buenos_Aires
