# -----------------------------------------------------------------------------
# Frontend env — copiar a `.env` y ajustar. NO commitear `.env`.
# -----------------------------------------------------------------------------

# Si está en true, todas las llamadas al backend pasan por src/api/mock/handlers.ts
# (data fixture in-memory). Útil para desarrollar el SPA sin backend corriendo.
VITE_USE_MOCK=false

# Origen del backend (Spring Boot). El cliente le agrega /api/v1 automáticamente.
# Mismo nombre que inyecta docker-compose/Dockerfile (fuente de verdad).
VITE_API_BASE_URL=http://localhost:8080

# Keycloak — para el flujo OIDC PKCE del SPA
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=imedba
VITE_KEYCLOAK_CLIENT_ID=imedba-frontend
